[user]
	email = chen-jd22@mails.tsinghua.edu.cn
	name = 陈纪东
[init]
	defaultBranch = main
[core]
	editor = vi
[alias]
	last = log -1 HEAD
	cgl = config --global --list
	who = ! git config --get user.name && git config --get user.email
	set = config --global
	dif = diff
	unstage = restore --staged
	st = status
	sw = switch
	co = checkout
	cm = commit
[url "git@github.com:"]
	insteadOf = https://github.com/
[pull]
	rebase = false
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
